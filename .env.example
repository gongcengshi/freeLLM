# freeLLM Configuration

# Server
PORT=3001
HOST=0.0.0.0

# Data directory
DATA_DIR=~/.freellm

# Encryption key for API keys (auto-generated if not set)
ENCRYPTION_KEY=

# Proxy API key (required for API access)
PROXY_API_KEY=

# Admin password (optional, for admin panel access)
ADMIN_PASSWORD=

# CORS
CORS_ORIGIN=*

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Provider API keys (add your keys here)
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
